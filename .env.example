# Server-only values. Never prefix these with NEXT_PUBLIC_. No default account.
GRA_APP_ORIGIN=http://localhost:3000
GRA_SESSION_PASSWORD=
GRA_AUTH_USERS_JSON=[]
# Local single-process testing only. Vercel refuses memory mode.
GRA_SECURITY_STORE=memory
GRA_REDIS_REST_URL=
GRA_REDIS_REST_TOKEN=
# [{"id":"integration-id","sha256":"SHA256_OF_HIGH_ENTROPY_TOKEN","scopes":["webhook:ingest"]}]
GRA_SERVICE_TOKENS_JSON=[]
# Exact origins/hostnames only. Never use wildcards.
GRA_INTEGRATION_ORIGINS=
GRA_HTTP_ALLOWED_HOSTS=
# Existing external audit feature is synthetic-only and opt-in.
GRA_ENABLE_SYNTHETIC_AUDIT=false
NEXT_TELEMETRY_DISABLED=1
